{
  "name": "unit-testing-solution",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "pnpm run dev",
    "dev": "vite",
    "build": "run-p build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:ci": "run-p type-check:test \"test:unit --run --coverage\"",
    "test:component": "playwright test -c playwright-ct.config.ts",
    "test:component:watch": "PW_TEST_HTML_REPORT_OPEN=never npx nodemon --watch ./ --ext vue,ts --exec 'pnpm test:component'",
    "test:component:ui": "playwright test -c playwright-ct.config.ts --ui",
    "test:integration": "playwright install && playwright test -c ./tests/integration/playwright.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.app.json --composite false"
  }
}
