{
  "name": "vue-training",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": "23"
  },
  "workspaces": [
    "_examples/*",
    "_exercises/*",
    "_solutions/*"
  ],
  "scripts": {
    "test-all": "pnpm -r exec vitest run --passWithNoTests",
    "build-all": "pnpm -r exec vite build",
    "prepare": "simple-git-hooks -ws -if-present",
    "preinstall": "npx only-allow pnpm",
    "start:1": "cd _exercises/01-Components && pnpm run dev",
    "start:2": "cd _exercises/02-Input-Output && pnpm run dev",
    "start:3a": "cd _exercises/03-Reactivity/ComputedProperties && pnpm run dev",
    "start:3b": "cd _exercises/03-Reactivity/VueDirectives && pnpm run dev",
    "start:4": "cd _exercises/04-Pinia && pnpm run dev",
    "start:5": "cd _exercises/05-Router && pnpm run dev",
    "start:6": "cd _exercises/06-Dynamic-Routes && pnpm run dev",
    "start:7": "cd _exercises/07-Unit-Testing && pnpm run dev",
    "start:8": "cd _exercises/08-Your-Turn && pnpm run dev",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@sit-onyx/icons": "1.0.0-beta.23",
    "@vueuse/core": "^13.9.0",
    "oidc-client-ts": "^3.3.0",
    "pinia": "^3.0.3",
    "sit-onyx": "1.0.0-beta.285",
    "vue": "^3.5.22",
    "vue-component-type-helpers": "^3.1.0",
    "vue-i18n": "^11.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@import-meta-env/cli": "~0.7.4",
    "@import-meta-env/typescript": "~0.4.1",
    "@import-meta-env/unplugin": "~0.6.3",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@pinia/testing": "^1.0.2",
    "@playwright/experimental-ct-vue": "~1.52.0",
    "@playwright/test": "~1.52.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "~0.7.0",
    "@yao-pkg/pkg": "^6.7.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-json": "^4.1.1",
    "sass-embedded": "^1.93.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.3.6",
    "vite-plugin-run": "~0.6.1",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0",
    "vitest-sonar-reporter": "^2.0.4",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.12",
    "z-vue-scan": "^0.0.35"
  },
  "lint-staged": {
    "*": [
      "prettier --write -u",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
