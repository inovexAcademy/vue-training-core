{
  "name": "vue-training",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "_examples/*",
    "_exercises/*",
    "_solutions/*"
  ],
  "scripts": {
    "test-all": "pnpm -r exec vitest run --passWithNoTests",
    "build-all": "pnpm -r exec vite build",
    "prepare": "simple-git-hooks -ws -if-present",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx playwright install",
    "start:welcome": "cd _examples/Welcome && pnpm run dev",
    "start:1": "cd _exercises/01-Components && pnpm run dev",
    "start:2": "cd _exercises/02-Input-Output && pnpm run dev",
    "start:3a": "cd _exercises/03-Reactivity/A-ComputedProperties && pnpm run dev",
    "start:3b": "cd _exercises/03-Reactivity/B-Directives && pnpm run dev",
    "start:4": "cd _exercises/04-Pinia && pnpm run dev",
    "start:5": "cd _exercises/05-Router && pnpm run dev",
    "start:6": "cd _exercises/06-Dynamic-Routes && pnpm run dev",
    "start:7": "cd _exercises/07-Unit-Testing && pnpm run test:unit",
    "start:8": "cd _exercises/08-Your-Turn && pnpm run dev",
    "start:all-in": "cd _exercises/99-All-In-One-Go && pnpm run dev",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@sit-onyx/icons": "1.12.0",
    "@vueuse/core": "^14.4.0",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.0.3",
    "sit-onyx": "1.19.0",
    "vue": "^3.5.41",
    "vue-component-type-helpers": "^3.3.10",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@import-meta-env/cli": "~0.7.4",
    "@import-meta-env/typescript": "~0.4.1",
    "@import-meta-env/unplugin": "~0.6.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@pinia/testing": "^2.0.1",
    "@playwright/experimental-ct-vue": "~1.62.1",
    "@playwright/test": "~1.62.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/tsconfig": "~0.9.1",
    "@yao-pkg/pkg": "^6.22.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "sass-embedded": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-run": "~0.9.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1",
    "vitest-sonar-reporter": "^3.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.10",
    "z-vue-scan": "^0.0.37"
  },
  "lint-staged": {
    "*": [
      "prettier --write -u",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
